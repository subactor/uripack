{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:uripack:schema:guard-config:v1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": "uripack.guard-config/v1"
    },
    "argv": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1,
      "maxItems": 32,
      "uniqueItems": true
    },
    "pinned_files": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "string",
        "pattern": "^[a-f0-9]{64}$"
      }
    },
    "timeout_seconds": {
      "type": "integer",
      "minimum": 1,
      "maximum": 300
    },
    "required_checks": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9.-]{0,95}$"
      },
      "minItems": 0,
      "maxItems": 100,
      "uniqueItems": true
    }
  },
  "required": [
    "schema",
    "argv",
    "pinned_files",
    "required_checks"
  ]
}
