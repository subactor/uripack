{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:uripack:schema:plan:v1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": "uripack.refactor-plan/v1"
    },
    "source_root": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024
    },
    "target_root": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024
    },
    "request": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema": {
          "const": "uripack.refactor-request/v1"
        },
        "operation": {
          "const": "plan"
        },
        "namespace": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9.-]{0,95}$"
        },
        "units": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9.-]{0,95}$"
              },
              "include": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 1024
                },
                "minItems": 1,
                "maxItems": 256,
                "uniqueItems": true
              },
              "public_uris": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 3,
                  "maxLength": 2048
                },
                "minItems": 0,
                "maxItems": 1000,
                "uniqueItems": true
              },
              "depends_on": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9.-]{0,95}$"
                },
                "minItems": 0,
                "maxItems": 100,
                "uniqueItems": true
              }
            },
            "required": [
              "id",
              "include"
            ]
          },
          "minItems": 1,
          "maxItems": 100,
          "uniqueItems": true
        },
        "checks": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9.-]{0,95}$"
          },
          "minItems": 0,
          "maxItems": 100,
          "uniqueItems": true
        },
        "limits": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "max_files": {
              "type": "integer",
              "minimum": 1,
              "maximum": 10000
            },
            "max_bytes": {
              "type": "integer",
              "minimum": 1,
              "maximum": 134217728
            }
          },
          "required": [
            "max_files",
            "max_bytes"
          ]
        }
      },
      "required": [
        "schema",
        "operation",
        "namespace",
        "units"
      ]
    },
    "request_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "source_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "operations": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "kind": {
                "const": "copy"
              },
              "source": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1024
              },
              "target": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1024
              },
              "sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "size": {
                "type": "integer",
                "minimum": 0
              },
              "mode": {
                "enum": [
                  420,
                  493
                ]
              },
              "unit": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9.-]{0,95}$"
              }
            },
            "required": [
              "kind",
              "source",
              "target",
              "sha256",
              "size",
              "mode",
              "unit"
            ]
          },
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "kind": {
                "const": "write"
              },
              "target": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1024
              },
              "content": {
                "type": "string"
              },
              "sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "mode": {
                "const": 420
              }
            },
            "required": [
              "kind",
              "target",
              "content",
              "sha256",
              "mode"
            ]
          }
        ]
      },
      "minItems": 1,
      "maxItems": 12000,
      "uniqueItems": true
    },
    "checks": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9.-]{0,95}$"
      },
      "minItems": 0,
      "maxItems": 100,
      "uniqueItems": true
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 0,
      "maxItems": 10000,
      "uniqueItems": true
    },
    "exclusions": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 0,
      "maxItems": 10000,
      "uniqueItems": true
    },
    "semantics": {
      "const": "copy-preserving-extraction; no cutover; behavioral verification separate"
    },
    "plan_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  },
  "required": [
    "schema",
    "source_root",
    "target_root",
    "request",
    "request_sha256",
    "source_sha256",
    "operations",
    "checks",
    "warnings",
    "exclusions",
    "semantics",
    "plan_sha256"
  ]
}
